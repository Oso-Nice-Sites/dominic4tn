# Copy to .env.local (gitignored) for local development. Every value here is
# optional: with none of them set, the site runs on its built-in content.
#
# NEXT_PUBLIC_* values are baked into the site at BUILD time — after changing
# them, rebuild/redeploy. None of these are secrets (a Sanity project ID is a
# public identifier); the only secret is the optional read token below.

# --- The website ----------------------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Only for a PRIVATE dataset (the default is public). Server-only; never commit.
# SANITY_API_READ_TOKEN=

# --- The content editor (Sanity Studio) -----------------------------------
# Sanity's tooling only exposes SANITY_STUDIO_* variables to the Studio, so the
# same project ID/dataset are repeated here.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# The <name> in https://<name>.sanity.studio (pick once, on first deploy).
# SANITY_STUDIO_HOST=
